{
  "name": "eka-ryan-portfolio",
  "version": "2.0.0",
  "description": "Eka Ryan Digital Solution - Portfolio Website with Cloudflare Pages, D1 & R2",
  "scripts": {
    "dev": "wrangler pages dev ./public --d1 DB=portfolio-db --r2 R2=portfolio-assets",
    "deploy": "wrangler pages deploy ./public --project-name ekaryandigitalsolution",
    "db:init": "wrangler d1 execute portfolio-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute portfolio-db --remote --file=./seed.sql",
    "db:local:init": "wrangler d1 execute portfolio-db --local --file=./schema.sql",
    "db:local:seed": "wrangler d1 execute portfolio-db --local --file=./seed.sql",
    "db:studio": "wrangler d1 execute portfolio-db --remote --command='SELECT * FROM services'",
    "r2:create": "wrangler r2 bucket create portfolio-assets",
    "setup": "npm run r2:create && npm run db:init && npm run db:seed",
    "preview": "wrangler pages dev ./public --d1 DB=portfolio-db --r2 R2=portfolio-assets"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
